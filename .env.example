# ============================================================
# Lumina — environment configuration TEMPLATE
# Create a private .env and fill in real values: install -m 0600 .env.example .env
# NEVER commit the real .env file.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_DEBUG=true                     # true locally, ALWAYS false in production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Root docker-compose.yml only. Keep this stable across release directories.
LUMINA_IMAGE=lumina:local
COMPOSE_PROJECT_NAME=lumina-production
# Must hold two spooled copies of each concurrent maximum-size upload, plus overhead.
LUMINA_TMPFS_SIZE_BYTES=268435456
# Compose .env values containing $ must be single-quoted to prevent interpolation.
# Required in production and hosted mode. Development may use an ephemeral key.
JWT_SECRET_KEY=
# Required in production and hosted mode; identifies the bootstrap administrator.
BOOTSTRAP_ADMIN_EMAIL=
# Required in production and hosted mode; send once as X-Bootstrap-Token.
# Prefer a generated URL-safe value without $ for Compose deployments.
BOOTSTRAP_ADMIN_TOKEN=

# ── Deployment mode (drives DB and document storage selection) ─
# self_hosted -> SQLite + local filesystem document storage
# hosted      -> PostgreSQL + S3-compatible storage; production requires s3
DEPLOYMENT_MODE=self_hosted

# ── Structured database ─────────────────────────────────────
# Production self_hosted SQLite must use an absolute path with an existing parent.
# self_hosted development example: sqlite:///./data/lumina.db
# hosted example:      postgresql+psycopg://USER:PASSWORD@HOST:5432/lumina
DATABASE_URL=sqlite:///./data/lumina.db

# ── Vector storage / document storage ───────────────────────
# VECTOR_BACKEND selects where chunk embeddings live. It defaults to the backend
# that matches DATABASE_URL: pgvector on PostgreSQL, chroma on SQLite. Setting
# pgvector with a non-PostgreSQL DATABASE_URL fails at startup.
# CHROMA_PERSIST_DIRECTORY holds the self-hosted vector collection and must be on
# durable storage; losing it means re-running the embedding backfill.
# CHROMA_PERSIST_DIRECTORY and UPLOAD_DIRECTORY must be absolute when the local
# backend or chroma vectors are used in production; hosted + s3 ignores both.
# Provision the production UPLOAD_DIRECTORY before application startup.
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── Semantic retrieval ──────────────────────────────────────
# RETRIEVAL_CHUNK_LIMIT is how many of a course's chunks semantic retrieval ranks
# for one generation request. RETRIEVAL_MIN_SIMILARITY is the cosine floor
# (0.0-1.0) below which a ranked chunk is discarded; when nothing clears the floor
# the request is rejected without calling the AI provider. Set the floor to 0.0 to
# disable it.
RETRIEVAL_CHUNK_LIMIT=24
RETRIEVAL_MIN_SIMILARITY=0.25
# STORAGE_BACKEND selects where uploaded documents live:
# local -> filesystem under UPLOAD_DIRECTORY (self-hosted)
# s3    -> S3-compatible bucket; hosted production requires s3
STORAGE_BACKEND=local
STORAGE_NAMESPACE=self-hosted
UPLOAD_DIRECTORY=./data/uploads
# ── S3-compatible storage (STORAGE_BACKEND=s3) ────────────────
# S3_BUCKET must exist; the hosted Compose creates it via minio-init.
# Without S3_ENDPOINT_URL (real AWS), S3_REGION is required. Static credentials
# are optional on AWS (prefer IAM roles); MinIO requires both keys.
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_REQUEST_SIZE_BYTES=1048576
MAX_CONCURRENT_DOCUMENT_VALIDATIONS=2
# Total deadline for upload admission and body receipt.
UPLOAD_REQUEST_TIMEOUT_SECONDS=300
MAX_DOCUMENTS_PER_COURSE=1000
MAX_COURSE_STORAGE_BYTES=2147483648
MAX_PDF_PAGES=500
MAX_PDF_PAGE_PIXELS=40000000
MAX_PDF_TOTAL_PIXELS=100000000
MAX_PDF_CONTENT_STREAM_BYTES=5242880
MAX_PDF_DRAWING_OPERATIONS=100000

# ── Embedding generation ────────────────────────────────────
# EMBEDDING_PROVIDER is separate from AI_PROVIDER: a deployment may pair a large
# generative model with a small dedicated embedding model. Implemented providers
# are ollama and gemini; openai and claude fail at startup.
# The stored vector width is fixed at 768, so changing the model to one with a
# different width requires a migration and a full re-embed.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# ── Visual understanding / image pipeline ────────────────────
# IMAGE_PROVIDER controls diagram, table, chart, and visual description
# extraction during document processing.
# Implemented: none | ollama | gemini. Defaults to none (disabled).
# openai and claude are recognized names but not implemented yet.
IMAGE_PROVIDER=none
OLLAMA_IMAGE_MODEL=llama3.2-vision
GEMINI_IMAGE_MODEL=gemini-2.5-flash
IMAGE_UNDERSTANDING_TIMEOUT_SECONDS=30
IMAGE_UNDERSTANDING_MAX_BYTES=10485760

# ── Durable document processing worker ──────────────────────
PROCESSING_JOB_LEASE_SECONDS=60
PROCESSING_JOB_MAX_ATTEMPTS=3
PROCESSING_JOB_POLL_SECONDS=1.0
PROCESSING_JOB_ATTEMPT_TIMEOUT_SECONDS=300
# Keep this at least PROCESSING_JOB_ATTEMPT_TIMEOUT_SECONDS + 45 seconds.
WORKER_STOP_GRACE_PERIOD=345s
MAX_EXTRACTED_CHARACTERS=2000000
MAX_DOCUMENT_CHUNKS=1000
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_TEXT_CHARACTERS=20
DOCUMENT_CHUNK_SIZE_CHARACTERS=1200
DOCUMENT_CHUNK_OVERLAP_CHARACTERS=200

# ── AI course-material context budget ───────────────────────────
# Maximum characters of course material placed into one generation request,
# per feature. The study guide and quiz bound retrieved material; flashcard, AI
# tutor and course Q&A still bound whole-corpus material until they migrate to
# semantic retrieval. Each value must be at least DOCUMENT_CHUNK_SIZE_CHARACTERS.
STUDY_GUIDE_MATERIAL_MAX_CHARS=120000
QUIZ_MATERIAL_MAX_CHARS=120000
FLASHCARD_MATERIAL_MAX_CHARS=120000
AI_TUTOR_MATERIAL_MAX_CHARS=120000
COURSE_QA_MATERIAL_MAX_CHARS=120000

# ── AI providers ────────────────────────────────────────────
# Implemented: ollama | gemini. See docs/ai_providers.md.
# openai and claude are recognized names but not implemented; selecting one
# fails at startup instead of failing the first generation request.
AI_PROVIDER=ollama
# Comma-separated providers tried when the primary fails. Same implemented set.
AI_FALLBACK_PROVIDERS=
# Per-request deadline for one generation, every provider. Raise it for local
# models on modest hardware; they are far slower than a hosted API.
AI_GENERATION_TIMEOUT_SECONDS=60
AI_GENERATION_MAX_ATTEMPTS=3
AI_GENERATION_BACKOFF_BASE_SECONDS=1.0
AI_GENERATION_BACKOFF_MAX_SECONDS=10.0
AI_GENERATION_MAX_CONCURRENCY=10
# Self-hosted Ollama. The model must already be pulled on that instance and
# must reliably emit JSON; docs/ai_providers.md lists the capability bar.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=your-gemini-key-here
# Reserved for planned providers. Not read by backend/app/config.py yet.
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
