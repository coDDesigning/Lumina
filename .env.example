# ============================================================
# Lumina — environment configuration TEMPLATE
# Create a private .env and fill in real values: install -m 0600 .env.example .env
# NEVER commit the real .env file.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_DEBUG=true                     # true locally, ALWAYS false in production
BACKEND_HOST=0.0.0.0
# Host port for the API itself. A browser does not need it: the frontend
# service publishes the single origin that serves both the interface and
# /api. Keep this for direct backend access, probes, and runbook commands.
BACKEND_PORT=8000
# Comma-separated exact browser origins. Empty disables cross-origin access.
# Example: https://app.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Root docker-compose.yml only. Keep this stable across release directories.
LUMINA_IMAGE=lumina:local
COMPOSE_PROJECT_NAME=lumina-production

# The frontend service serves the built interface and proxies /api to the API
# under one browser origin, so no CORS configuration is needed. After startup
# Lumina is at http://127.0.0.1:8080.
LUMINA_FRONTEND_IMAGE=lumina-frontend:local
# Loopback by default. Set 0.0.0.0 only to deliberately expose this machine's
# Lumina to the local network, and restrict /api/health/* at that edge.
LUMINA_BIND_ADDRESS=127.0.0.1
LUMINA_PORT=8080
LUMINA_FRONTEND_TMPFS_SIZE_BYTES=67108864
# Addresses whose X-Forwarded-For the API believes. The frontend service
# proxies every browser request, so this must cover the Compose network or
# per-IP rate limits treat all users as one client. The default covers the
# range Docker allocates Compose networks from.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# The complete API prefix compiled into the interface bundle. The default is a
# root-relative path, which is what makes the deployment same-origin. An
# absolute http(s) URL builds a deliberately cross-origin interface and then
# also requires CORS_ALLOWED_ORIGINS above. Changing this needs
# `docker compose build frontend`; restarting an existing container cannot
# rewrite an already-compiled bundle.
VITE_API_BASE_URL=/api
# Must hold two spooled copies of each concurrent maximum-size upload, plus overhead.
LUMINA_TMPFS_SIZE_BYTES=268435456
# Host directory for encrypted/off-host backup handling; never place it in the
# lumina-data volume. Override the archive name for every scheduled backup.
LUMINA_BACKUP_DIRECTORY=./backups
BACKUP_ARCHIVE_NAME=lumina-backup.tar.gz
# Compose .env values containing $ must be single-quoted to prevent interpolation.
# Required in production and hosted mode. Development may use an ephemeral key.
JWT_SECRET_KEY=
# Required in production and hosted mode; identifies the bootstrap administrator.
BOOTSTRAP_ADMIN_EMAIL=
# Required in production and hosted mode; send once as X-Bootstrap-Token.
# Prefer a generated URL-safe value without $ for Compose deployments.
BOOTSTRAP_ADMIN_TOKEN=

# ── Deployment mode (drives DB and document storage selection) ─
# self_hosted -> SQLite + local filesystem document storage
# hosted      -> PostgreSQL + S3-compatible storage; production requires s3
DEPLOYMENT_MODE=self_hosted

# ── Structured database ─────────────────────────────────────
# Production self_hosted SQLite must use an absolute path with an existing parent.
# self_hosted development example: sqlite:///./data/lumina.db
# hosted example:      postgresql+psycopg://USER:PASSWORD@HOST:5432/lumina
DATABASE_URL=sqlite:///./data/lumina.db
# Hosted PostgreSQL runtime pool. With RDS Proxy these values bound each
# API/worker process; total possible clients are replicas * (size + overflow).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=900

# ── Vector storage / document storage ───────────────────────
# VECTOR_BACKEND selects where chunk embeddings live. It defaults to the backend
# that matches DATABASE_URL: pgvector on PostgreSQL, chroma on SQLite. Setting
# pgvector with a non-PostgreSQL DATABASE_URL fails at startup.
# CHROMA_PERSIST_DIRECTORY holds the self-hosted vector collection and must be on
# durable storage; losing it means re-running the embedding backfill.
# CHROMA_PERSIST_DIRECTORY and UPLOAD_DIRECTORY must be absolute when the local
# backend or chroma vectors are used in production; hosted + s3 ignores both.
# Provision the production UPLOAD_DIRECTORY before application startup.
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── Semantic retrieval ──────────────────────────────────────
# RETRIEVAL_CHUNK_LIMIT is how many of a course's chunks semantic retrieval ranks
# for one generation request. RETRIEVAL_MIN_SIMILARITY is the cosine floor
# (0.0-1.0) below which a ranked chunk is discarded; when nothing clears the floor
# the request is rejected without calling the AI provider. Set the floor to 0.0 to
# disable it.
RETRIEVAL_CHUNK_LIMIT=24
RETRIEVAL_MIN_SIMILARITY=0.25
# STORAGE_BACKEND selects where uploaded documents live:
# local -> filesystem under UPLOAD_DIRECTORY (self-hosted)
# s3    -> S3-compatible bucket; hosted production requires s3
STORAGE_BACKEND=local
STORAGE_NAMESPACE=self-hosted
UPLOAD_DIRECTORY=./data/uploads
# ── S3-compatible storage (STORAGE_BACKEND=s3) ────────────────
# S3_BUCKET must exist; the hosted Compose creates it via minio-init.
# Without S3_ENDPOINT_URL (real AWS), S3_REGION is required. Static credentials
# are optional on AWS (prefer IAM roles); MinIO requires both keys.
# S3_BUCKET=lumina
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_REQUEST_SIZE_BYTES=1048576
MAX_CONCURRENT_DOCUMENT_VALIDATIONS=2
# Total deadline for upload admission and body receipt.
UPLOAD_REQUEST_TIMEOUT_SECONDS=300
MAX_DOCUMENTS_PER_COURSE=1000
MAX_COURSE_STORAGE_BYTES=2147483648
MAX_PDF_PAGES=500
MAX_PDF_PAGE_PIXELS=40000000
MAX_PDF_TOTAL_PIXELS=100000000
MAX_PDF_CONTENT_STREAM_BYTES=5242880
MAX_PDF_DRAWING_OPERATIONS=100000

# ── Embedding generation ────────────────────────────────────
# EMBEDDING_PROVIDER is separate from AI_PROVIDER: a deployment may pair a large
# generative model with a small dedicated embedding model. Implemented providers
# are ollama and gemini; openai and claude fail at startup.
# The stored vector width is fixed at 768, so changing the model to one with a
# different width requires a migration and a full re-embed.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# ── Visual understanding / image pipeline ────────────────────
# IMAGE_PROVIDER controls diagram, table, chart, and visual description
# extraction during document processing.
# Implemented: none | ollama | gemini. Unset or empty resolves based on DEPLOYMENT_MODE:
# - hosted resolves to gemini only when primary AI_PROVIDER is gemini and the
#   configured model advertises vision; otherwise resolves to none (no cross-routing).
# - self_hosted resolves to ollama only when the configured OLLAMA_IMAGE_MODEL
#   advertises vision in the catalog; otherwise safely defaults to none (disabled)
#   with an informational startup log.
# Explicitly setting IMAGE_PROVIDER=none disables visual extraction.
# openai and claude are recognized names but not implemented yet.
IMAGE_PROVIDER=none
OLLAMA_IMAGE_MODEL=llama3.2-vision
GEMINI_IMAGE_MODEL=gemini-2.5-flash
IMAGE_UNDERSTANDING_TIMEOUT_SECONDS=30
IMAGE_UNDERSTANDING_MAX_BYTES=10485760

# ── Durable document processing worker ──────────────────────
PROCESSING_JOB_LEASE_SECONDS=60
PROCESSING_JOB_MAX_ATTEMPTS=3
PROCESSING_JOB_POLL_SECONDS=1.0
PROCESSING_JOB_ATTEMPT_TIMEOUT_SECONDS=300
# Documents processed at once by one worker process. Each slot needs two
# database connections, so hosted deployments must keep
# 2 * PROCESSING_JOB_CONCURRENCY + 1 within DATABASE_POOL_SIZE plus
# DATABASE_MAX_OVERFLOW. Maximum 6.
PROCESSING_JOB_CONCURRENCY=2
# Durable AI generation uses separate slots in the same worker process. A
# student's third active request remains queued until one of the first two ends.
GENERATION_JOB_LEASE_SECONDS=120
GENERATION_JOB_MAX_ATTEMPTS=2
GENERATION_JOB_POLL_SECONDS=1.0
GENERATION_JOB_ATTEMPT_TIMEOUT_SECONDS=600
GENERATION_JOB_CONCURRENCY=2
GENERATION_JOB_MAX_ACTIVE_PER_USER=2
# Keep this above the larger processing or generation attempt timeout.
WORKER_STOP_GRACE_PERIOD=645s
MAX_EXTRACTED_CHARACTERS=2000000
MAX_DOCUMENT_CHUNKS=1000
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_TEXT_CHARACTERS=20
DOCUMENT_CHUNK_SIZE_CHARACTERS=1200
DOCUMENT_CHUNK_OVERLAP_CHARACTERS=200

# ── Periodic maintenance & reconciliation ───────────────────
# Automatic background cleanup and vector synchronization.
# Set an interval to 0 to disable that maintenance cycle in the background worker.
# COURSE_PURGE_INTERVAL_SECONDS: seconds between scans for stranded tombstoned courses.
COURSE_PURGE_INTERVAL_SECONDS=3600
# EMBEDDING_BACKFILL_INTERVAL_SECONDS: seconds between scans for missing vectors.
EMBEDDING_BACKFILL_INTERVAL_SECONDS=3600
EMBEDDING_BACKFILL_BATCH_SIZE=64
EMBEDDING_BACKFILL_PRUNE_ORPHANS=false
AI_USAGE_RETENTION_DAYS=90
AI_USAGE_CLEANUP_BATCH_SIZE=1000

# ── AI course-material context budget ───────────────────────────
# Maximum characters of course material placed into one generation request,
# per feature. Each value must be at least DOCUMENT_CHUNK_SIZE_CHARACTERS.
# Study guide, quiz, AI tutor, course Q&A, and exam analysis head each
# retrieved passage with a citation key, which spends part of the budget, so
# they carry a wider one than flashcards, which emit no citations. See
# docs/citations.md.
STUDY_GUIDE_MATERIAL_MAX_CHARS=126000
QUIZ_MATERIAL_MAX_CHARS=126000
FLASHCARD_MATERIAL_MAX_CHARS=120000
AI_TUTOR_MATERIAL_MAX_CHARS=126000
COURSE_QA_MATERIAL_MAX_CHARS=126000
EXAM_ANALYSIS_MATERIAL_MAX_CHARS=126000
EXAM_PAST_PAPER_MAX_CHARS=126000
EXAM_TOPIC_GUIDE_MATERIAL_MAX_CHARS=126000
EXAM_TOPIC_SUMMARY_MATERIAL_MAX_CHARS=60000
EXAM_TOPIC_QUIZ_MATERIAL_MAX_CHARS=126000
EXAM_SIMILAR_QUESTIONS_MATERIAL_MAX_CHARS=126000
EXAM_MOCK_EXAM_MATERIAL_MAX_CHARS=126000
EXAM_REVIEW_SHEET_MATERIAL_MAX_CHARS=126000
EXAM_MOCK_EXAM_QUESTION_COUNT=20
EXAM_QUIZ_DEFAULT_QUESTION_COUNT=10

# ── AI providers ────────────────────────────────────────────
# Implemented: ollama | gemini | openai | claude. See docs/ai_providers.md.
AI_PROVIDER=ollama
# Comma-separated providers tried when the primary fails. Same implemented set (e.g. openai,claude).
AI_FALLBACK_PROVIDERS=
# Optional JSON model catalog keyed by provider.
AI_MODEL_CATALOG=
# Optional versioned USD rates used to price successful telemetry events. Model
# keys are exact provider:model identities. Unknown models remain explicitly
# unpriced rather than inheriting a fallback rate.
# AI_MODEL_COST_RATES={"version":"2026-08-24","models":{"gemini:gemini-3.6-flash":{"prompt_usd_per_million_tokens":0.30,"completion_usd_per_million_tokens":2.50},"openai:gpt-5.6-terra":{"prompt_usd_per_million_tokens":2.50,"completion_usd_per_million_tokens":10.00},"claude:claude-sonnet-5":{"prompt_usd_per_million_tokens":3.00,"completion_usd_per_million_tokens":15.00}}}
AI_MODEL_COST_RATES=
# Per-request deadline for one generation, every provider. Raise it for local
# models on modest hardware; they are far slower than a hosted API.
AI_GENERATION_TIMEOUT_SECONDS=60
AI_GENERATION_MAX_ATTEMPTS=3
AI_GENERATION_BACKOFF_BASE_SECONDS=1.0
AI_GENERATION_BACKOFF_MAX_SECONDS=10.0
AI_GENERATION_MAX_CONCURRENCY=10
# Self-hosted Ollama. The model must already be pulled on that instance and
# must reliably emit JSON; docs/ai_providers.md lists the capability bar.
# Root Compose reaches an Ollama process on the host through this name. Use
# http://localhost:11434 when running Python directly. On Linux, start Ollama
# with OLLAMA_HOST=0.0.0.0:11434 and firewall the port to the Docker bridge.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# Sampling options sent with every Ollama request. Ollama's own defaults are
# tuned for chat, not for schema-constrained JSON; temperature 0.8 makes a small
# model violate hard constraints such as "exactly four options" often enough to
# fail whole generations. See the single-GPU box profile in docs/ai_providers.md.
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
# num_ctx is sent per request, so the model does not need a custom Modelfile and
# a server-wide OLLAMA_CONTEXT_LENGTH cannot silently inflate the KV cache.
# The prompt and the response share this window.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_REPEAT_PENALTY=1.1
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Overall deadline for the entire generation request including all retries and fallbacks.
# Must be less than ALB idle timeout (120s). Default 110s.
AI_GENERATION_OVERALL_TIMEOUT_SECONDS=110
AI_GRADING_OVERALL_TIMEOUT_SECONDS=45

# ── Credit lifecycle ────────────────────────────────────────
# Full policy in docs/credits.md. Credits meter hosted AI generation; self-hosted
# operators supply their own inference, so metering is off for them. Unset, this
# follows DEPLOYMENT_MODE: true when hosted, false when self_hosted. The value
# below is spelled out to match this template's DEPLOYMENT_MODE=self_hosted --
# change it with the mode, or delete the line to track the mode automatically.
# While false nothing is charged, refunded, or granted, no charge or refund rows
# are written, and the API reports a null balance rather than a frozen number.
CREDIT_METERING_ENABLED=false
# Granted once at registration, recorded as an INITIAL_GRANT ledger row.
CREDIT_INITIAL_GRANT=50.0
# Granted at most once per calendar month, lazily on the next charge or balance
# read. The grant is trimmed so it never carries a balance past CREDIT_MAX_BALANCE.
CREDIT_PERIODIC_GRANT=50.0
# Ceiling for automatic granting only. It never reduces a balance, and deliberate
# administrator grants and adjustments are not capped by it.
CREDIT_MAX_BALANCE=100.0

# ── Rate limiting ────────────────────────────────────────────
# Full policy in docs/rate_limiting.md. Per-IP and per-account login attempts
# allowed within the window before a 429; the account dimension additionally
# locks out progressively (see RATE_LIMIT_LOCKOUT_* below).
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
# Per-IP registration attempts allowed within the window before a 429.
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# Per-user, per-feature AI generation requests allowed within the window before
# a 429. Checked ahead of CreditService.charge, so a throttled request never
# spends credit.
RATE_LIMIT_GENERATION_MAX_ATTEMPTS=30
RATE_LIMIT_GENERATION_WINDOW_SECONDS=3600
# Progressive lockout for repeated account-login violations: the first lockout
# lasts the base duration, each further violation while still recently locked
# doubles it, capped at the max.
RATE_LIMIT_LOCKOUT_BASE_SECONDS=30
RATE_LIMIT_LOCKOUT_MAX_SECONDS=1800
# Per-IP email verification attempts (redeem and resend combined) allowed within
# the window before a 429. Keyed by IP rather than by address so an attacker
# cannot lock a victim out of verifying their own account.
RATE_LIMIT_VERIFICATION_MAX_ATTEMPTS=5
RATE_LIMIT_VERIFICATION_WINDOW_SECONDS=3600
# Per-IP password reset request attempts allowed within the window before a 429.
RATE_LIMIT_PASSWORD_RESET_MAX_ATTEMPTS=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600

# ── Authentication hardening ────────────────────────────────
# Full policy in docs/authentication.md.
# Minimum password length, enforced identically in registration and password
# change. Length leads the policy and no character composition is demanded.
# NIST SP 800-63B floor is 8; bcrypt truncates at 72 bytes, so values above 64
# are rejected at startup.
PASSWORD_MIN_LENGTH=8
# Whether an address must be proven reachable before the account receives its
# introductory and monthly credits. Unset, this follows DEPLOYMENT_MODE: true
# when hosted, false when self_hosted. Turning it on requires
# APP_PUBLIC_BASE_URL, EMAIL_FROM_ADDRESS, and SMTP_HOST, because a deployment
# that cannot deliver the link would create accounts nobody could finish.
EMAIL_VERIFICATION_REQUIRED=false
# How long an issued verification link stays redeemable. Every link is
# single-use regardless; this bounds how long a leaked one is worth anything.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# How long an issued password reset link stays redeemable.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Access token (JWT) lifespan. After expiration, a new login is required.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Origin the verification link points at, without a trailing path. This is the
# address a user's browser reaches, which is the SPA rather than the API.
# Example: https://app.example.com
APP_PUBLIC_BASE_URL=
# Envelope sender for verification mail. Use an address the SMTP relay is
# authorized to send as, or the relay will reject the message. The hosted
# deployment sends as info@lumina-study.com; a self-hosted one must use its own.
EMAIL_FROM_ADDRESS=
# SMTP relay. SMTP_USERNAME and SMTP_PASSWORD are optional; supply both or
# neither. SMTP_USE_TLS issues STARTTLS after connecting, which is what port 587
# expects; disable it only for a relay on the same private network.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# ── Response security headers ───────────────────────────────
# Applied by the application to every response, including the ones middleware
# returns before a route runs. Existing values are never overwritten, so a proxy
# or CDN in front of the API stays authoritative for the headers it already
# sets. Disable only when a boundary you control sets all of them.
SECURITY_HEADERS_ENABLED=true
# HSTS is a promise the browser remembers for a year, so it defaults on only in
# hosted mode, where TLS is known to terminate in front of the API. A
# self-hosted deployment behind a TLS reverse proxy should set it to true; one
# served over plain HTTP must leave it false or browsers will refuse to reach it.
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000

# ── Optional hosted advertising ─────────────────────────────
# ENABLE_HOSTED_ADS controls the optional privacy-preserving advertising path.
# Strictly forbidden in self_hosted mode (setting true raises a startup error).
# In hosted mode, defaults to false (kill-switch ready).
ENABLE_HOSTED_ADS=false
HOSTED_ADS_PROVIDER=ethicalads
HOSTED_ADS_PUBLISHER_ID=lumina
