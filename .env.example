# ============================================================
# Lumina — environment configuration TEMPLATE
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit the real .env file.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_DEBUG=true                     # true locally, ALWAYS false in production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Deployment mode (drives DB / vector / storage selection) ─
# self_hosted -> SQLite + ChromaDB + local filesystem storage
# hosted      -> PostgreSQL + pgvector + AWS S3 storage
DEPLOYMENT_MODE=self_hosted

# ── Structured database ─────────────────────────────────────
# self_hosted example: sqlite:///./data/lumina.db
# hosted example:      postgresql+psycopg://USER:PASSWORD@HOST:5432/lumina
DATABASE_URL=sqlite:///./data/lumina.db

# PostgreSQL settings (hosted mode only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lumina
POSTGRES_USER=lumina_user
POSTGRES_PASSWORD=change-me

# ── Vector search / storage (self-hosted mode) ──────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads

# ── AI providers ────────────────────────────────────────────
AI_PROVIDER=ollama                 # ollama | openai | gemini | claude
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── AWS (hosted mode only) ──────────────────────────────────
AWS_REGION=eu-central-1
AWS_S3_BUCKET=lumina-uploads-bucket
# Note: prefer GitHub OIDC / IAM roles over long-lived access keys.