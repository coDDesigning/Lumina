# Lumina self-hosted frontend: the built SPA plus the single-origin entrypoint
# that fronts it. The backend image is built from ./Dockerfile and deliberately
# contains no frontend files; these two images are never merged.
#
# The build context is the repository root, which the root .dockerignore
# excludes frontend/ from. Dockerfile.frontend.dockerignore sits beside this
# file and replaces that ignore list for this build only, so the backend image
# keeps its own contract that /app/frontend does not exist.

FROM node:22.22.0-alpine@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS build

# NODE_ENV must not be production here: vite and typescript are
# devDependencies, and npm would skip them.
ENV NODE_ENV=development \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_update_notifier=false

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json ./
# frontend/tsconfig.json references e2e/tsconfig.json, and Vite parses that
# reference graph while resolving the HTML entry, so the build needs this one
# file even though it never compiles the Playwright suite that owns it.
COPY frontend/e2e/tsconfig.json ./e2e/tsconfig.json
COPY frontend/vite.config.ts frontend/index.html ./
COPY frontend/public/favicon.ico frontend/public/favicon-32x32.png \
     frontend/public/icon-192.png frontend/public/apple-touch-icon.png ./public/
COPY frontend/src ./src

# Inlined by Vite at build time, so changing it needs a rebuild rather than a
# restart. The application validates it at module scope and throws on a bad
# value, which shows as a blank page; the supported values are the default
# root-relative /api and an absolute http(s) URL for a deliberate cross-origin
# build, which then also needs CORS_ALLOWED_ORIGINS set on the API.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# vite build rather than npm run build. The package script is "tsc -b && vite
# build", and tsc -b resolves a project reference to frontend/e2e/tsconfig.json,
# which would drag the Playwright suite into this image to satisfy a type check
# the Frontend quality and build CI job already runs on every push.
RUN npx --no-install vite build \
    && test -f dist/index.html \
    && test -f dist/favicon.ico \
    && test -d dist/assets


FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 AS runtime

COPY ops/nginx/default.conf          /etc/nginx/conf.d/default.conf
COPY ops/nginx/security-headers.conf /etc/nginx/lumina-security-headers.conf
COPY ops/nginx/proxy-api.conf        /etc/nginx/lumina-proxy-api.conf

# Served from its own directory rather than over the base image's
# /usr/share/nginx/html, which already ships an index.html and a 50x.html.
COPY --from=build /build/dist /usr/share/nginx/lumina

# The same immutability the backend image asserts over /app. nginx -t turns a
# configuration mistake into a failed build instead of a crash-looping
# container; it binds nothing, so running it as root here is safe.
USER root
RUN find /usr/share/nginx/lumina -type d -exec chmod 0555 {} + \
    && find /usr/share/nginx/lumina -type f -exec chmod 0444 {} + \
    && chmod 0444 /etc/nginx/conf.d/default.conf \
                  /etc/nginx/lumina-security-headers.conf \
                  /etc/nginx/lumina-proxy-api.conf \
    && nginx -t
USER 101

EXPOSE 8080
