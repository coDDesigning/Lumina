# Replaces the root .dockerignore for builds that use this Dockerfile, so the
# frontend sources it excludes reach this context. Everything the backend
# context excludes for secrecy or size is still excluded here.
.git
**/.git
.github
.env
.env.*
.venv
**/.venv
venv
**/venv
**/__pycache__
**/*.py[cod]
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.mypy_cache
**/.mypy_cache
.coverage
**/.coverage
htmlcov
**/htmlcov
# Anchored to the repository root on purpose: the runtime state directories
# live there, while frontend/src/data holds application source.
/data
/uploads
/chroma
/chroma_db
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log
**/*.pem
**/*.key
**/credentials*.json
node_modules
**/node_modules
dist
**/dist
coverage
**/coverage
frontend/e2e
!frontend/e2e/tsconfig.json
frontend/playwright-report
frontend/blob-report
frontend/test-results
alembic
app
backend
routes
schemas
services
storage
tests
utils
workers
terraform
docs
.user
